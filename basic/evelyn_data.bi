FUNCTION LessonStarter$ (n AS INTEGER)
    DIM s AS STRING
    s = ""
    IF n = 1 THEN s = "PRINT " + CHR$(34) + "HELLO OASIS" + CHR$(34)
    IF n = 2 THEN s = "LET a = 6" + CHR$(10) + "LET b = 7" + CHR$(10) + "PRINT a * b"
    IF n = 3 THEN s = "CLEAR" + CHR$(10) + "REPEAT 4" + CHR$(10) + "  MOVE 3" + CHR$(10) + "  TURN RIGHT" + CHR$(10) + "END"
    IF n = 4 THEN s = "LET water = 3" + CHR$(10) + "IF water < 5 THEN PRINT " + CHR$(34) + "FIND WELL" + CHR$(34)
    LessonStarter$ = s
END FUNCTION
