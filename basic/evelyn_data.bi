    id = LibAdd%(t, c, f, x)
    t = "binary numbers"
    c = "coding"
    f = "Computers represent every letter, number, and sound using ju" + "st two states: 0 and 1 (bits)."
    x = "In binary, 5 is 101 because (1*4) + (0*2) + (1*1) = 5."
    id = LibAdd%(t, c, f, x)
